{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsuba",
  "version": "0.1.0",
  "identifier": "dev.tsuba.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tsuba",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "在陌生代码第一次运行之前，先替你看一眼",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "mainBinaryName": "tsuba-app"
}