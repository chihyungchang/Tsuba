<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release bundles are signed with the hardened runtime (required for notarization). The engine compiles YARA rules
  with yara-x, whose WebAssembly runtime writes and runs machine code in plain RWX memory: without this entitlement
  macOS kills the App and the terminal checker the moment they compile the rule pack. allow-jit is not a substitute
  (it expects MAP_JIT memory) and, added alongside, still gets the process killed.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
